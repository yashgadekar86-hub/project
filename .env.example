# AI Forex Command Center - Environment Configuration Template
# Copy to .env and fill in your values. NEVER commit .env to Git.

# ===== Application =====
APP_NAME="AI Forex Command Center"
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# ===== JWT / Auth =====
JWT_SECRET_KEY=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ===== Database (PostgreSQL) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aifx_user
POSTGRES_PASSWORD=CHANGE_ME_AIFX_DB_PASSWORD
POSTGRES_DB=aifx_trading
DATABASE_URL=postgresql+asyncpg://aifx_user:CHANGE_ME_AIFX_DB_PASSWORD@localhost:5432/aifx_trading

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ===== Celery / Task Queue =====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== MT5 Connection =====
# Path to the MT5 terminal executable (examples)
# Windows: C:\\Program Files\\MetaTrader 5\\terminal64.exe
# Linux (Wine): /home/user/.wine/drive_c/Program Files/MetaTrader 5/terminal64.exe
MT5_TERMINAL_PATH=
# Default broker/server (optional - user can override in UI)
MT5_DEFAULT_SERVER=
MT5_DEFAULT_LOGIN=
MT5_DEFAULT_PASSWORD=
# Encryption key for stored MT5 credentials (Fernet key, generated on first run)
CREDENTIAL_ENCRYPTION_KEY=

# ===== Trading Safety Defaults =====
DEFAULT_RISK_PER_TRADE_PCT=0.5
DEFAULT_MAX_DAILY_LOSS_PCT=2.0
DEFAULT_MAX_DRAWDOWN_PCT=5.0
DEFAULT_MAX_SIMULTANEOUS_TRADES=3
DEFAULT_MIN_AI_CONFIDENCE=70
DEFAULT_MIN_RISK_REWARD=2.0
DEFAULT_MAX_SPREAD_PIPS_MAJORS=3.0
DEFAULT_MAX_CONSECUTIVE_LOSSES=3
DEFAULT_TRADING_MODE=paper    # paper | live | backtest (NEVER default to live)
LIVE_TRADING_REQUIRES_EXPLICIT_ACTIVATION=true

# ===== News Feed (optional) =====
# Leave blank to disable news filtering; never claim news filtering is active without a source
NEWS_API_KEY=
NEWS_FILTER_ENABLED=false
NEWS_BLOCK_MINUTES_BEFORE=60
NEWS_BLOCK_MINUTES_AFTER=30

# ===== Alerts =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ===== Logging =====
LOG_LEVEL=INFO
LOG_FORMAT=json
